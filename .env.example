# study-tutor environment variables
# Copy to .env and fill in values. DO NOT commit .env.
# Per SR-06: placeholder values in <angle-bracket> form only. Never use
# "not_needed", "sk-test-xxxx", or any value that could silently override
# a real shell-environment key during variable interpolation.

# --- Provider selection (SR-03) ---
# Values: local | bedrock | openai | anthropic | gemini
# Default: local (fine-tuned Gemma on GB10 via Ollama).
AGENT_MODELS__REASONING_MODEL=local       # Player (Phase 0 default)
AGENT_MODELS__COACH_MODEL=                 # Coach — must differ from REASONING_MODEL (D3 invariant); env-var snapshot at boot, server restart required after rotation

# --- Local provider (Player) ---
# `local` is the provider-name discriminator. The endpoint behind it can be
# Mac Ollama, llama-swap on the GB10, or any Ollama-compatible HTTP server —
# the code path doesn't care which.
LOCAL_BASE_URL=<http://your-local-llm-host:11434>
# LOCAL_MODEL is set in the "NATS fleet" section below (gemma4-tutor by
# default). Override here only if your direct-Ollama setup uses a different
# model tag than the llama-swap fleet model.
# Token ceiling per generate call. The Ollama-compatible server default
# (~128) truncates GCSE essay scaffolds; 2048 fits Intro + Body ×2 +
# Conclusion with headroom. Raise if you see mid-sentence cut-offs on longer
# prompts (TASK-PO02F-002).
LOCAL_NUM_PREDICT=2048

# --- Local-coach provider (Coach: GB10 llama-swap over Tailscale) ---
# Coach must differ from REASONING_MODEL exactly (D3 invariant). Env-var
# snapshot at boot — server restart required after rotation. When
# LOCAL_COACH_BASE_URL is unset the Coach falls back to LOCAL_BASE_URL so
# single-host setups still work.
LOCAL_COACH_BASE_URL=<http://your-llama-swap-host:9000>
LOCAL_COACH_MODEL=<your-coach-model-tag>

# --- Bedrock provider (FEAT-PO-004) ---
# Phase 0 stubs Bedrock; values here are for Phase 1 activation.
AWS_REGION=<your-aws-region>
BEDROCK_MODEL_ARN=<your-bedrock-custom-model-arn>

# --- API providers (optional; Coach may use a different provider than Player) ---
# OPENAI_API_KEY is set in the "NATS fleet" section below for the llama-swap
# default. Override here only if you actually need a real OpenAI cloud key for
# the Coach (e.g. AGENT_MODELS__COACH_MODEL=openai).
ANTHROPIC_API_KEY=<your-anthropic-key-here>
GOOGLE_API_KEY=<your-google-genai-key-here>

# --- NATS fleet (FEAT-NATS Phase 1) ---
# These variables wire the agent into the NATS fleet (TASK-NATS-PH1-*) and
# point the LLM client at llama-swap on the GB10. Operator fills in NATS_USER /
# NATS_PASSWORD locally; do not commit real credentials.

# NATS fleet
NATS_URL=nats://localhost:4222
NATS_USER=
NATS_PASSWORD=

# Agent identity
AGENT_ID=gcse-tutor

# LLM endpoint (llama-swap on GB10)
# IMPORTANT: OPENAI_BASE_URL MUST include the /v1 suffix.
# Without it, langchain-openai POSTs to /chat/completions instead of /v1/chat/completions
# and gets a 404. See docs/reviews/REVIEW-NATS-FLEET-PATTERNS-2026-05-08.md Bug #3.
OPENAI_BASE_URL=http://host.docker.internal:9000/v1
LLM_BASE_URL=http://host.docker.internal:9000
LOCAL_MODEL=gemma4-tutor
OPENAI_API_KEY=local-no-auth-required

# Heartbeat
HEARTBEAT_INTERVAL_SECONDS=30

# --- Postgres StudentStore (ADR-ARCH-023 / FEAT-SMP-001) ---
# The study-tutor-owned Postgres store for durable learner state + sessions
# (JSONB, no pgvector). Replaces the retired Graphiti/FalkorDB student model.
# REQUIRED by every serve command (serve / serve-nats / serve-http): it backs
# the SessionService the tutor runtime hard-requires, so a missing DSN is a
# fail-fast boot error. Own instance/volume/port 5434 — never share
# fleet-memory's DB. See docs/runbooks/RUNBOOK-study-tutor-postgres-deploy.md.
STUDY_TUTOR_PG_DSN=<postgresql://study_tutor:PASSWORD@your-postgres-host:5434/study_tutor>

# --- HTTP Session API (FEAT-APP-001) ---
# HTTP adapter deployment: deploy/http/docker-compose.yml (independent of NATS).
# Token-table auth (interim single-user, pre-Keycloak): JSON object mapping
# Bearer tokens to student_id values. See docs/design/contracts/API-session-http-binding.md §5.1.
#
# Dev flavour (two tokens):
#   STUDY_TUTOR_HTTP_TOKENS={"token-lilymay": "lilymay", "token-alex": "alex"}
# Prod flavour (single token):
#   STUDY_TUTOR_HTTP_TOKENS={"token-lilymay": "lilymay"}
STUDY_TUTOR_HTTP_TOKENS=<{"token-user": "student_id"}>

# Dev-only reset flag (TASK-APP1-05): gates POST /__dev__/reset (truncates
# session + session_turn rows for test isolation). Set to "1" to enable the
# route; unset for prod (route does not exist when unset).
# Dev: STUDY_TUTOR_HTTP_DEV_RESET=1
# Prod: leave unset
# STUDY_TUTOR_HTTP_DEV_RESET=
