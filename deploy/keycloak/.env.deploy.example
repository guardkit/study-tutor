# Copy to .env (gitignored), chmod 600, fill values.
# Deploy + gates: docs/runbooks/RUNBOOK-study-tutor-keycloak-deploy.md (TASK-KC-005)

# Database connection (co-located keycloak database on study_tutor_postgres instance)
KC_DB_PASSWORD=                            # generate: openssl rand -base64 24

# Hostname (pinned for stable issuer — ADR-ARCH-028 D1)
KC_HOSTNAME=whitestocks.tailebf801.ts.net:8443
KC_HTTPS_PORT=8443

# TLS certificates (tailscale cert paths on NAS host)
KC_TLS_CERT_PATH=                          # e.g., /volume1/docker/study_tutor/keycloak/certs/whitestocks.tailebf801.ts.net.crt
KC_TLS_KEY_PATH=                           # e.g., /volume1/docker/study_tutor/keycloak/certs/whitestocks.tailebf801.ts.net.key

# Bootstrap admin (initial admin user, env-only)
KC_BOOTSTRAP_ADMIN_USERNAME=               # e.g., admin
KC_BOOTSTRAP_ADMIN_PASSWORD=               # generate: openssl rand -base64 24

# Deployment metadata
NAS_HOST=whitestocks.tailebf801.ts.net
NAS_USER=RichardWoollcott
NAS_SSH_PORT=22
NAS_DOCKER_ROOT=/volume1/docker/study_tutor

# Keycloak admin console URL (after deploy):
#   https://whitestocks.tailebf801.ts.net:8443/admin
# Issuer URL (for OIDC clients):
#   https://whitestocks.tailebf801.ts.net:8443/realms/study-tutor
